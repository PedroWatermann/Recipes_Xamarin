<?xml version="1.0" encoding="utf-8" ?>
<FlyoutPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Recipes.Views.PagPrincipal">
    <FlyoutPage.Flyout>
        <ContentPage
            Title="Menu"
            BackgroundColor="#FF9800">

            <StackLayout Margin="10">
                <Image
                    Source="chefe.png"
                    HorizontalOptions="CenterAndExpand"/>
                <Label
                    Text="Recipes"
                    FontAttributes="Bold"
                    TextColor="Black"
                    FontSize="30"
                    HorizontalOptions="CenterAndExpand"
                    Margin="0, 0, 0, 50"/>
            </StackLayout>
        </ContentPage>
    </FlyoutPage.Flyout>

    <FlyoutPage.Detail>
        <ContentPage
            Title="Home"
            BackgroundColor="#FF9800">
            <Label
                Text="Hello, World!"
                TextColor="Black"/>
        </ContentPage>
    </FlyoutPage.Detail>
</FlyoutPage>