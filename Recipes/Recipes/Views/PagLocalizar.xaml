<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Recipes.Views.PagLocalizar"
             Title="Pesquisar"
             BackgroundColor="#DF7800"
             Padding="10, 10, 10, 30">
    <ContentPage.ToolbarItems>
        <ToolbarItem
            Text="Home"
            IconImageSource="home_white_2.png"
            x:Name="btnHome"
            Clicked="btnHome_Clicked"/>
    </ContentPage.ToolbarItems>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        
        <Label
            Text="Título: "
            TextColor="Black"
            FontSize="25"
            FontAttributes="Bold"
            HorizontalOptions="StartAndExpand"
            Grid.Row="0"
            Grid.Column="0"
            VerticalOptions="End"/>
        <Entry
            Placeholder="Digite o título da receita"
            PlaceholderColor="#CFCFCF"
            Grid.Row="1"
            Grid.Column="0"
            HorizontalOptions="FillAndExpand"
            VerticalOptions="Start"
            x:Name="entTitulo"
            TextChanged="entTitulo_TextChanged"/>

        <Image
            Source="star_white.png"
            Grid.Row="1"
            Grid.Column="1"
            HorizontalOptions="EndAndExpand"
            HeightRequest="60"
            VerticalOptions="Start"
            x:Name="imgFavorito">
            <Image.GestureRecognizers>
                <TapGestureRecognizer
                    NumberOfTapsRequired="1"
                    x:Name="tapImgFavorito"
                    Tapped="tapImgFavorito_Tapped"/>
            </Image.GestureRecognizers>
        </Image>

        <Frame
            Grid.Row="2"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            BackgroundColor="Transparent"
            BorderColor="Black"
            CornerRadius="21"
            Padding="1"
            x:Name="frmBorda">
            <Frame
                BackgroundColor="Transparent"
                BorderColor="Black"
                CornerRadius="20"
                Padding="0"
                x:Name="frmLista">
                <ListView
                    HasUnevenRows="True"
                    SeparatorColor="Blue"
                    Margin="15"
                    x:Name="lvwReceita"
                    ItemSelected="lvwReceita_ItemSelected"
                    VerticalOptions="FillAndExpand"
                    SeparatorVisibility="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <ViewCell>
                                <Frame
                                    BackgroundColor="Transparent"
                                    BorderColor="Black"
                                    Padding="0"
                                    Margin="0, 5"
                                    CornerRadius="10">
                                    <StackLayout Orientation="Horizontal">
                                        <Label
                                                Text="{Binding titulo, StringFormat='{0}'}"
                                                TextColor="Black"
                                                FontSize="23"
                                                FontAttributes="Bold"
                                                VerticalOptions="CenterAndExpand"
                                                HorizontalOptions="CenterAndExpand"/>
                                        <Image
                                                WidthRequest="50"
                                                HorizontalOptions="End">
                                            <Image.Triggers>
                                                <DataTrigger
                                                        TargetType="Image" 
                                                        Binding="{Binding favorito}"
                                                        Value="true">
                                                    <Setter
                                                            Property="Source"
                                                            Value="star_white_filled.png"/>
                                                </DataTrigger>
                                                <DataTrigger
                                                        TargetType="Image"
                                                        Binding="{Binding favorito}"
                                                        Value="false">
                                                    <Setter 
                                                            Property="Source"
                                                            Value="star_white.png"/>
                                                </DataTrigger>
                                            </Image.Triggers>
                                        </Image>
                                    </StackLayout>
                                </Frame>
                            </ViewCell>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Frame>
        </Frame>
        <Frame
            Grid.Row="2"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            BackgroundColor="Transparent"
            BorderColor="Black"
            CornerRadius="21"
            Padding="1"
            IsVisible="False"
            x:Name="frmReceita">
            <Label
                Text="Nenhuma receita adicionada!"
                TextColor="Black"
                FontSize="20"
                FontAttributes="Bold"
                HorizontalOptions="CenterAndExpand"
                VerticalOptions="CenterAndExpand"
                IsVisible="False"
                x:Name="lblReceita"/>
        </Frame>
    </Grid>
</ContentPage>